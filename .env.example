# Copy to .env and fill in real values. .env is gitignored (holds secrets).
#   cp .env.example .env

# Compose settings
COMPOSE_PROJECT_NAME=paperless

# Caddy TLS settings
# Domains for TLS certificates. Items separated by comma + space: ", "
TLS_DOMAINS="localhost, nextcloud.local"
# eMail for auto TLS (Let's Encrypt)
ADMIN_EMAIL=admin@example.com

# Paperless URL, should match an entry of TLS_DOMAINS. No trailing slash.
PAPERLESS_URL=https://localhost

# Database engine. Default postgresql (matches the db service). Set to sqlite
# only if you drop the db service.
PAPERLESS_DBENGINE=postgresql

###############################################################################
# Reverse proxy                                                               #
#  Mode A (default): bundled Caddy terminates TLS on 80/443 -> webserver.     #
#  Mode B: external proxy. Clear COMPOSE_PROFILES so Caddy is NOT started,     #
#          point your proxy at the published webserver port below.            #
###############################################################################

# "local-proxy" = start bundled Caddy (mode A). Empty = external proxy (mode B).
COMPOSE_PROFILES=local-proxy

# Backend docker network addressing. Change only if these ranges collide with an
# existing network on the host. Keep them mutually consistent:
#   - BACKEND_IP_RANGE must be a subset of BACKEND_SUBNET (Docker's dynamic pool).
#   - CADDY_BACKEND_IP must be inside BACKEND_SUBNET but OUTSIDE BACKEND_IP_RANGE
#     (so the dynamic pool never hands Caddy's fixed IP to another container).
#   - If you change CADDY_BACKEND_IP, set PAPERLESS_TRUSTED_PROXIES to match (mode A).
BACKEND_SUBNET=172.28.0.0/16
BACKEND_IP_RANGE=172.28.1.0/24
CADDY_BACKEND_IP=172.28.0.2

# Host bind for the webserver port. Used by an external proxy (mode B); an
# unused loopback bind in mode A.
#  - proxy on the same host:   127.0.0.1:8000
#  - proxy elsewhere on LAN:   0.0.0.0:8000  (or a specific LAN IP, e.g.
#                              192.168.1.10:8000)
PAPERLESS_WEBSERVER_BIND=127.0.0.1:8000

# Comma-separated proxy IPs paperless trusts for X-Forwarded-*. IPv4 + IPv6 ok,
# mixed in one list. Comma-separated, no spaces, e.g.:
#   PAPERLESS_TRUSTED_PROXIES=172.28.0.1,192.168.1.20,fd00:11::2,2001:db8::1
#  Mode A (local Caddy): 172.28.0.2  (Caddy's fixed backend IP).
#  Mode B (external): the address paperless SEES the proxied connection from.
#    With a published port this is usually the docker bridge gateway
#    (172.28.0.1), NOT the proxy's real IP (docker DNAT hides the source, even
#    for a LAN proxy). Confirm from the webserver logs and set accordingly.
PAPERLESS_TRUSTED_PROXIES=172.28.0.2

# Caddy TLS directive. https://caddyserver.com/docs/caddyfile/directives/tls
# - Public host with Let's Encrypt: leave CADDY_TLS empty.
# - Self-signed internal:            CADDY_TLS="tls internal"
# - Local mkcert dev certs:          point at the mounted ./certs (see below).
# CADDY_TLS="tls internal"
# CADDY_TLS="tls /certs/localhost+2.pem /certs/localhost+2-key.pem"

# Versions
VALKEY_VERSION=9
POSTGRES_VERSION=18
GOTENBERG_VERSION=8.34
PAPERLESS_NGX_VERSION=3.0.3
TKKA_VERSION=latest

# Postgres credentials (used by both the db service and paperless)
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=changeMe

# Paperless secrets (injected into the container via docker-compose.yml).
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=changeMe
# Default superuser created on first start.
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=admin@example.com
PAPERLESS_ADMIN_PASSWORD=changeMe

# Docker settings
DOCKER_LOGGING_MAX_SIZE=5m
DOCKER_LOGGING_MAX_FILE=3

###############################################################################
# Paperless AI (v3) — optional. Leave PAPERLESS_AI_ENABLED=false to disable.  #
# Backend runs elsewhere (remote Ollama over WireGuard, or an OpenAI-like API).#
###############################################################################
PAPERLESS_AI_ENABLED=false

# Backend: "ollama" (native) or "openai-like" (OpenAI / LocalAI / vLLM / Ollama /v1).
PAPERLESS_AI_LLM_BACKEND=ollama
# Ollama over the WireGuard tunnel: http://<ollama-wg-ip>:11434 (no /v1).
# openai-like: https://host/v1  (+ set PAPERLESS_AI_LLM_API_KEY).
PAPERLESS_AI_LLM_ENDPOINT=
PAPERLESS_AI_LLM_MODEL=qwen2.5:7b
# Only for openai-like backends (bearer token). Empty for native ollama.
PAPERLESS_AI_LLM_API_KEY=

PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
PAPERLESS_AI_LLM_EMBEDDING_MODEL=nomic-embed-text

# Required (true) when the endpoint is a private/LAN/VPN IP (SSRF guard). Keep
# false when the endpoint is a public host.
PAPERLESS_AI_LLM_ALLOW_INTERNAL_ENDPOINTS=false
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=de
# Raise for slow remote inference (seconds).
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
